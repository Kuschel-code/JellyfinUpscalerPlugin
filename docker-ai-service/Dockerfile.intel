# Intel GPU (OpenVINO) Dockerfile for AI Upscaler Service
# Use this for Intel integrated GPUs (iGPU) or Intel Arc discrete GPUs
# Requires: Docker with --device=/dev/dri for GPU access

# OpenVINO 2025.4.1 — latest stable (2024.0.0 was outdated)
# Pinned by digest for reproducible, supply-chain-safe builds (digest fetched 2026-06-18; bump tag+digest together).
FROM openvino/ubuntu22_runtime:2025.4.1@sha256:303018e029969694af48e9a0b09288d13e718bffc975a865c17762dc4e68df69

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV USE_GPU=true
ENV OPENVINO_DEVICE=GPU

# Build-time metadata — REQUIRED build arg, set by CI from the release tag:
#   --build-arg APP_VERSION=<tag> --build-arg APP_COMMIT=$(git rev-parse --short HEAD)
# v1.8.3.13: no default here on purpose. Six Dockerfiles had drifted to 1.8.2
# while one said 1.8.3.8, so /status, /health and the dashboard reported a
# wrong, inconsistent service version. The code keeps a "dev" fallback for
# bare local runs; verify-release.ps1 asserts no Dockerfile re-introduces a
# version default.
ARG APP_VERSION
ARG APP_COMMIT=unknown
ENV APP_VERSION=${APP_VERSION} \
    APP_COMMIT=${APP_COMMIT}

LABEL org.opencontainers.image.title="Jellyfin AI Upscaler (Intel OpenVINO)" \
      org.opencontainers.image.description="AI Upscaler Service with Intel GPU via OpenVINO 2025.4 (Arc A-Series, Iris Xe, iGPU)" \
      org.opencontainers.image.vendor="Kuschel-code" \
      org.opencontainers.image.source="https://github.com/Kuschel-code/JellyfinUpscalerPlugin" \
      org.opencontainers.image.documentation="https://github.com/Kuschel-code/JellyfinUpscalerPlugin/blob/main/docker-ai-service/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${APP_COMMIT}"

USER root

WORKDIR /app

# Install system dependencies first
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    curl \
    pciutils \
    gpg-agent \
    software-properties-common \
    ocl-icd-libopencl1 \
    clinfo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Intel GPU compute runtime: the OpenVINO base already ships it (intel-opencl-icd and
# intel-level-zero-gpu 24.48.31907.7 with IGC 2.2.3, the stack OpenVINO 2025 is validated with).
# Until v1.8.3.36 a step here added Intel's jammy/lts/2350 (2023) repo and installed the same
# packages from it. That apt-get install failed on every build - the published image contains
# the repo list and key but none of the five packages - and the trailing
# `|| echo "clinfo: no platforms found"` swallowed the failure. Had it ever succeeded it would
# have put a 2023 driver under OpenVINO 2025. Removed; the guard after the pip step fails the
# build if the GPU runtime is ever missing.

# Ensure render/video groups exist, then add root + openvino for GPU access
RUN groupadd -f render && groupadd -f video && \
    usermod -aG render root 2>/dev/null || true && \
    usermod -aG video root 2>/dev/null || true && \
    usermod -aG render openvino 2>/dev/null || true && \
    usermod -aG video openvino 2>/dev/null || true

# Copy requirements first for better caching
# v1.8.3.20 - installs the LOCK, not the .txt.
# The .txt carries human-readable ranges; the .lock is the resolved, hash-pinned
# build input (generated inside this exact base image by lock-requirements.yml).
# --require-hashes makes pip refuse anything whose content does not match, so a
# re-uploaded wheel at the same version can no longer slip in unnoticed.
COPY requirements-intel.lock ./requirements.lock

# Install Python dependencies (Intel/OpenVINO version)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --require-hashes -r requirements.lock

# Build-time provider assert (issue #69 root-cause guard): fail the build if the
# OpenVINO ExecutionProvider is not present. This is the exact bug that shipped in
# v1.7.5 - plain onnxruntime built fine but had no OpenVINO EP, so the image ran on
# CPU while the dashboard showed the Intel GPU. This assert makes that impossible.
RUN python3 -c "import onnxruntime as ort; p = ort.get_available_providers(); print('ONNX providers:', p); assert 'OpenVINOExecutionProvider' in p, 'BUILD FAIL: OpenVINOExecutionProvider missing - use onnxruntime-openvino, not plain onnxruntime'"

# Issue #98 lesson: "available" only means compiled in. The OpenVINO EP and the GPU plugin
# bundled in the wheel must also resolve their libraries (the GPU plugin needs libOpenCL.so.1),
# and an Intel OpenCL driver must be registered, or the GPU plugin sees no device and the image
# silently runs on the CPU. ldd only reads the libraries, it runs no code.
RUN set -e; \
    CAPI="$(python3 -c "import os, onnxruntime; print(os.path.join(os.path.dirname(onnxruntime.__file__), 'capi'))")"; \
    for lib in libonnxruntime_providers_openvino.so libopenvino_intel_gpu_plugin.so; do \
      if [ ! -f "$CAPI/$lib" ]; then echo "BUILD FAIL: $CAPI/$lib missing"; exit 1; fi; \
      if ldd "$CAPI/$lib" | grep "not found"; then echo "BUILD FAIL: $lib does not resolve its libraries"; exit 1; fi; \
    done; \
    ICD="$(cat /etc/OpenCL/vendors/intel.icd 2>/dev/null || true)"; \
    if [ -z "$ICD" ] || [ ! -f "$ICD" ]; then echo "BUILD FAIL: no Intel OpenCL driver registered (/etc/OpenCL/vendors/intel.icd -> '$ICD') - the OpenVINO GPU plugin would see no GPU"; exit 1; fi; \
    echo "OK: OpenVINO EP and GPU plugin resolve, Intel OpenCL driver: $ICD"

# Copy application code
COPY app/ ./app/
COPY static/ ./static/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create directories for models and cache
RUN mkdir -p /app/models /app/cache /app/config && \
    chown -R openvino:openvino /app /entrypoint.sh

# Run as non-root openvino user for security.
# NOTE: We intentionally keep the 'openvino' user (not 'appuser' like Dockerfile.cpu)
# because the openvino/ubuntu22_runtime base image pre-configures this user with
# the correct Intel GPU group memberships (render/video) needed for OpenCL/Level-Zero
# hardware access. Changing to a different user would require re-granting all GPU
# device permissions and risks breaking GPU passthrough on Arc/iGPU hardware.
USER openvino

# Expose API port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run the application via entrypoint
# Note: uses python3 (not python) because the openvino base image doesn't create a python symlink
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
