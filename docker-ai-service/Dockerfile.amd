# ============================================
# AI Upscaler Service - AMD GPU (ROCm) Version
# ============================================
# Build: docker build -f Dockerfile.amd -t kuscheltier/jellyfin-ai-upscaler:amd .
# Run: docker run --device=/dev/kfd --device=/dev/dri --group-add <host GID of /dev/kfd and renderD128> -p 5000:5000 kuscheltier/jellyfin-ai-upscaler:amd

# ROCm 7.2.4 runtime + libraries (MIOpen, hipBLAS, hipFFT), no PyTorch.
# Issue #98: the base used to be rocm/pytorch:rocm6.2 (ROCm 6.2, libamdhip64.so.6), while
# `pip install "onnxruntime-rocm<=1.22.99"` resolved to 1.22.2.post3, which is built against
# ROCm 7.2.4 (NEEDED libamdhip64.so.7 + libhipblas.so.3, RUNPATH /opt/rocm-7.2.4/lib). The ROCm
# EP library could not even be opened, onnxruntime silently ran everything on the CPU, and
# get_available_providers() kept listing ROCm because it reports the build, not a load.
# The base and the wheel are pinned TOGETHER now: bump both or neither.
# The service runs inference through ONNX Runtime only, so the 20 GB PyTorch base bought nothing.
# Pinned by digest (fetched 2026-10-07; single-arch linux/amd64 image).
FROM rocm/dev-ubuntu-22.04:7.2.4-complete@sha256:e3909c89d9434e2816568f727e89bf6a00d6d9d746defc6b9957dbeb16d1ac31

# Build-time metadata — REQUIRED build arg, set by CI from the release tag:
#   --build-arg APP_VERSION=<tag> --build-arg APP_COMMIT=$(git rev-parse --short HEAD)
# v1.8.3.13: no default here on purpose. Six Dockerfiles had drifted to 1.8.2
# while one said 1.8.3.8, so /status, /health and the dashboard reported a
# wrong, inconsistent service version. The code keeps a "dev" fallback for
# bare local runs; verify-release.ps1 asserts no Dockerfile re-introduces a
# version default.
ARG APP_VERSION
ARG APP_COMMIT=unknown
ENV APP_VERSION=${APP_VERSION} \
    APP_COMMIT=${APP_COMMIT}

LABEL org.opencontainers.image.title="Jellyfin AI Upscaler (AMD ROCm)" \
      org.opencontainers.image.description="AI Upscaler Service with AMD ROCm 7.2 GPU Acceleration (RDNA2/RDNA3/RDNA4)" \
      org.opencontainers.image.vendor="Kuschel-code" \
      org.opencontainers.image.source="https://github.com/Kuschel-code/JellyfinUpscalerPlugin" \
      org.opencontainers.image.documentation="https://github.com/Kuschel-code/JellyfinUpscalerPlugin/blob/main/docker-ai-service/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${APP_COMMIT}"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV USE_GPU=true
# rocm-smi / rocminfo for GPU detection and for users debugging inside the container.
ENV PATH="/opt/rocm/bin:${PATH}"
# HSA_OVERRIDE_GFX_VERSION: Set this at runtime for YOUR specific GPU if needed.
# Example: HSA_OVERRIDE_GFX_VERSION=11.0.0 for RX 7900 (gfx1100)
# Do NOT set a default — it breaks GPUs that aren't gfx1100.
# ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for OpenCV
# The ROCm base ships no Python; Ubuntu 22.04's is 3.10 (the onnxruntime-rocm wheel needs >=3.10).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python-is-python3 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for layer caching
# NOT hash-pinned, deliberately (docs/DOCKER-IMAGES.md): the AMD stack is resolved in this base.
COPY requirements-amd.txt requirements.txt

# Install Python dependencies, then the ROCm ONNX Runtime.
# onnxruntime-rocm 1.22.x is the last line with the ROCm EP (removed after v1.23).
#
# The wheel is pinned EXACTLY to the build that matches the base's ROCm 7.2.4 (see FROM).
# A floating "<=1.22.99" is what broke the image when post2/post3 moved from ROCm 6.4 to 7.2.
#
# IMPORTANT (FIX-2): onnxruntime-rocm PROVIDES the `onnxruntime` module itself, so plain
# `onnxruntime` must NOT be present alongside it - the plain build (Azure/CPU) would shadow
# the ROCm one. requirements-amd.txt does not list it; any copy pulled in anyway is removed.
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip && \
    python3 -m pip install -r requirements.txt && \
    { python3 -m pip uninstall -y onnxruntime onnxruntime-gpu || true; } && \
    python3 -m pip install "onnxruntime-rocm==1.22.2.post3"

# Build-time provider guard (issues #69, #98). Two checks, because the first one alone passed
# for a CPU-only image: get_available_providers() lists ROCm from the build config, so the
# provider library must also RESOLVE against this image's ROCm libraries - a wheel/base ROCm
# mismatch fails here with "libamdhip64.so.N => not found". ldd, not dlopen: loading the
# library initialises HIP, which aborts on a build machine without an AMD GPU.
RUN python3 -c "import onnxruntime as ort; p = ort.get_available_providers(); print('ONNX providers:', p); assert 'ROCMExecutionProvider' in p, 'BUILD FAIL: ROCMExecutionProvider missing - plain onnxruntime (CPU) would ship under the amd tag'" && \
    ROCM_EP="$(python3 -c "import os, onnxruntime; print(os.path.join(os.path.dirname(onnxruntime.__file__), 'capi', 'libonnxruntime_providers_rocm.so'))")" && \
    { test -f "$ROCM_EP" || { echo "BUILD FAIL: $ROCM_EP missing"; exit 1; }; } && \
    if ldd "$ROCM_EP" | grep "not found"; then echo "BUILD FAIL: the ROCm EP library does not resolve against this image's ROCm - onnxruntime-rocm and the base image are built for different ROCm versions"; exit 1; fi && \
    echo "OK: ROCMExecutionProvider present and its ROCm libraries resolve"

# Copy application code
COPY app/ ./app/
COPY static/ ./static/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create non-root user for running the service
# Add to video group for /dev/kfd and /dev/dri GPU access
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser && \
    usermod -aG video appuser 2>/dev/null || true && \
    usermod -aG render appuser 2>/dev/null || true

# Create directories for models and cache
RUN mkdir -p /app/models /app/cache /app/config && \
    chown -R appuser:appuser /app

# Expose API port
EXPOSE 5000

# Run as non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run the application via entrypoint
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
